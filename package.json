{
  "name": "azeroth-skylines",
  "version": "1.0.0",
  "description": "A World of Warcraft themed city builder in the spirit of Cities: Skylines, bundled into a single shareable HTML file.",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack serve --mode development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "sheet": "webpack --config webpack.sheet.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaidAndFade/AzerothSkylines.git"
  },
  "keywords": [
    "game",
    "city-builder",
    "warcraft",
    "isometric",
    "canvas",
    "typescript",
    "single-file"
  ],
  "author": "RaidAndFade",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RaidAndFade/AzerothSkylines/issues"
  },
  "homepage": "https://github.com/RaidAndFade/AzerothSkylines#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^2.1.9",
    "css-loader": "^7.1.5",
    "eslint": "^9.39.5",
    "html-inline-script-webpack-plugin": "^3.2.1",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.9",
    "webpack": "^5.110.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.6"
  },
  "private": true
}
